# ---- Noesis environment variables ----
# Copy to .env for local dev, or set these in the Vercel dashboard for production.

# --- AI (required) ---
GEMINI_API_KEY=                 # Google AI Studio key (primary)
OPENROUTER_API_KEY=             # OpenRouter key (automatic fallback when Gemini is out of quota)

# --- Voice (optional but recommended) ---
ELEVENLABS_API_KEY=             # ElevenLabs key — natural voice (TTS) + speech-to-text (Scribe)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # must be a voice on your account (free tier can't use Voice-Library voices)

# --- Database ---
# Local dev leaves these unset (uses a local file: noesis.db).
# Production (Vercel) REQUIRES a hosted libsql/Turso database — the filesystem is ephemeral.
DATABASE_URL=                   # e.g. libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=            # Turso auth token

# --- Push notifications for refresher nudges (optional) ---
# Generate with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=                    # any random string; Vercel Cron sends it as a Bearer token to protect /api/cron/nudge

# --- Optional model overrides ---
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# GROQ_API_KEY=                 # optional speech-to-text fallback
